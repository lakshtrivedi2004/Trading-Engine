# Dev unit - runs alongside prod (trading-engine, port 8090) from a separate
# checkout at /root/Trading-Engine-dev, dashboard on port 8091. Mode is read
# from that checkout's .trading_mode by run_engine_dev.sh at every start.
# Switch by hand: deployment/switch_mode_dev.sh paper|live.
#
# Install (run these as commands, not part of this file):
#   git clone <repo> /root/Trading-Engine-dev   # separate checkout from prod
#   cp deployment/trading-engine-dev.service /etc/systemd/system/trading-engine-dev.service
#   systemctl daemon-reload
#   systemctl enable --now trading-engine-dev
#   systemctl status trading-engine-dev
#   systemctl restart trading-engine-dev
#   systemctl stop trading-engine-dev
#   tail -f /root/Trading-Engine-dev/engine.log
#   journalctl -u trading-engine-dev -n 50
#   systemctl restart trading-engine-dev

[Unit]
Description=Trading-Engine DEV (mode read from .trading_mode at each start)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=root
WorkingDirectory=/root/dev/Trading-Engine
Environment=PYTHONUNBUFFERED=1
ExecStart=/root/dev/Trading-Engine/deployment/run_engine_dev.sh
Restart=on-failure
RestartSec=10
KillSignal=SIGUSR1
TimeoutStopSec=30
StandardOutput=append:/root/Trading-Engine/engine.log
StandardError=append:/root/Trading-Engine/engine.log

[Install]
WantedBy=multi-user.target
